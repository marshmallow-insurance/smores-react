exports[`CheckboxCard > renders a checkbox named by its label 1`] = `
.c3 {
  clip: rect(0 0 0 0);
  clip-path: inset(50%);
  height: 1px;
  overflow: hidden;
  position: absolute;
  white-space: nowrap;
  width: 1px;
  margin: 0;
}

.c4 {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 24px;
  height: 24px;
  border: 2px solid #292924;
  border-radius: 4px;
  background-color: #ffffff;
  color: #ffffff;
}

.c4 svg {
  display: none;
  height: 16px;
  overflow: visible;
}

.c2:checked+.c4 {
  border-color: #292924;
  background-color: #292924;
}

.c2:checked+.c4 svg {
  display: block;
}

.c2:focus-visible+.c4 {
  outline: 2px solid #0e0e0c;
  outline-offset: 2px;
}

.c0 {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-sizing: border-box;
  padding: 12px 16px;
  border-radius: 16px;
  background-color: #f1e9dc;
  color: #292924;
  cursor: pointer;
}

.c1 {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.c5 {
  position: absolute;
  inset: 0;
  border: 2px solid transparent;
  border-radius: 16px;
  pointer-events: none;
}

.c2:checked~.c5 {
  border-color: #292924;
}

.c6 {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
  padding: 4px 0;
  overflow-wrap: break-word;
}

.c7 {
  margin: -2px 0;
  font-size: 16px;
  font-weight: 500;
  line-height: 1.25;
}

@media (hover: hover) {
  label:hover .c4 {
    background-color: #f8f2ea;
  }

  label:hover .c2:checked+.c4 {
    border-color: #0e0e0c;
    background-color: #0e0e0c;
  }
}

