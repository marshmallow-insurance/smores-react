{
  "name": "@mrshmllw/smores-react",
  "version": "16.2.16",
  "description": "Collection of React components used by Marshmallow Technology",
  "main": "./dist/index.js",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "react",
    "components",
    "design system",
    "component library"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./beta": {
      "types": "./dist/beta/index.d.ts",
      "default": "./dist/beta/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc --p ./tsconfig.build.json",
    "build-storybook": "storybook build -c .storybook",
    "check-types": "if [ -n \"$GITHUB_ACTIONS\" ]; then concurrently --raw \"npm run check-tsc\" \"npm run lint\" -s all; else concurrently --group \"npm run check-tsc\" \"npm run lint\" -s all --timings true; fi",
    "lint": "if [ -n \"$GITHUB_ACTIONS\" ]; then oxlint --format=github; else oxlint; fi",
    "prepublishOnly": "npm run build",
    "start": "npm run storybook",
    "storybook": "storybook dev -p 6006",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "npm run test-storybook --maxWorkers=2",
    "test:coverage": "vitest --coverage --silent",
    "test:watch": "vitest --watch --silent",
    "test": "vitest --silent",
    "updateSnaps": "vitest --u",
    "snyk-protect": "snyk-protect",
    "prepare": "npm run snyk-protect && husky",
    "pre-commit-lint": "npm run check-tsc && lint-staged",
    "commitlint": "commitlint --edit",
    "fix-package-lock-conflicts": "echo \"Make sure conflicts in package.json are resolved before running this script\" && npm i --package-lock-only",
    "check-tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@awesome.me/kit-46ca99185c": "^1.0.22",
    "@floating-ui/react": "0.27.20",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@lexical/code-core": "^0.49.0",
    "@lexical/code-shiki": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@mrshmllw/smores-foundations": "^1.1.1",
    "body-scroll-lock": "^4.0.0-beta.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "fuse.js": "^7.5.0",
    "lexical": "^0.49.0",
    "polished": "^4.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@mrshmllw/campfire": "^7.1.0",
    "@snyk/protect": "^1.1307.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-coverage": "^3.0.2",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/body-scroll-lock": "^3.1.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-playwright": "^2.2.2",
    "concurrently": "^10.0.5",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest-styled-components": "^7.4.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "storybook": "^10.2.13",
    "styled-components": "^6.5.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marshmallow-insurance/smores-react.git"
  },
  "author": "Todor Tsankov",
  "license": "MIT",
  "homepage": "https://github.com/marshmallow-insurance/smores-react#readme",
  "snyk": true
}
